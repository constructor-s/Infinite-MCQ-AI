{
  "compilerOptions": {
    "target": "ES2022",
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "api/**/*.ts",
    "src/data/**/*.ts",
    "src/server/**/*.ts",
    "src/lib/*.ts",
    "curriculum/*.json"
  ],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
